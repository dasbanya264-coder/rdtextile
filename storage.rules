rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product catalog images and video media
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Store branding and settings (banner, logo)
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Customer attachments / order design references
    match /orders/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
